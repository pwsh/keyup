# Keyup development targets.  Everything runs against the venv in backend/.venv and
# throwaway Postgres containers, so nothing here depends on the compose stack.

BACKEND      := backend
VENV         := $(BACKEND)/.venv
PY           := $(VENV)/bin/python
PIP          := $(VENV)/bin/pip
DEV_DB_NAME  := keyup-dev-pg
DEV_DB_PORT  := 55440
TEST_DB_NAME := keyup-test-pg
TEST_DB_PORT := 55441
PG_IMAGE     := postgres:18
DEV_DB_URL   := postgresql+psycopg://keyup:keyup@localhost:$(DEV_DB_PORT)/keyup
TEST_DB_URL  := postgresql+psycopg://keyup:keyup@localhost:$(TEST_DB_PORT)/keyup_test
AUDIO_ROOT   ?= $(CURDIR)/audio

export DATABASE_URL ?= $(DEV_DB_URL)
export AUDIO_ROOT

.PHONY: help venv lock lock-upgrade dev-db test-db stop-db migrate ingest watch test lint fmt edge-check \
        migration-roundtrip e2e third-party bootstrap update

help:
	@grep -E '^[a-z0-9-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN{FS=":.*?## "}{printf "  %-10s %s\n", $$1, $$2}'

# The two operator entry points of a compose install (README "Quick start").  Options go
# through ARGS, e.g. `make bootstrap ARGS="--non-interactive --admin admin"`.
ARGS ?=

bootstrap: ## first install: .env with fresh secrets, the stack, an admin and a recorder token
	scripts/bootstrap.sh $(ARGS)

update: ## git pull --ff-only, build, migrate, restart, wait for health
	scripts/update.sh $(ARGS)

venv: ## create backend/.venv from the lock (the image's exact versions + the test tools)
	python3 -m venv $(VENV)
	$(PIP) install --quiet --upgrade pip
	$(PIP) install --quiet --require-hashes -r $(BACKEND)/requirements-dev.lock
	$(PIP) install --quiet --no-deps -e '$(BACKEND)'
	@echo "venv ready: $(VENV)"

# The locks, all generated by uv from pyproject.toml.  requirements.lock is what the api/worker
# image installs (base + rr, plus hatchling so the package itself installs offline);
# requirements-openvino.lock the stt-openvino image (its openvino wheels stay on the base
# image's release train: move them only together with Dockerfile.openvino's FROM);
# requirements-dev.lock the dev venv (requirements.lock + the test tools).  Both extra locks
# are constrained by requirements.lock, so the versions agree everywhere.  `lock` keeps
# every existing pin and only resolves what pyproject.toml added or dropped;
# `lock-upgrade` moves requirements.lock to the newest releases.
UV_COMPILE := uv pip compile --python-version 3.12 --python-platform linux --generate-hashes \
              --custom-compile-command "make lock" --quiet

lock: ## regenerate backend/requirements*.lock, keeping current pins
	cd $(BACKEND) && printf 'hatchling\n' | $(UV_COMPILE) pyproject.toml - --extra rr \
	  -o requirements.lock $(LOCK_UPGRADE)
	cd $(BACKEND) && printf 'hatchling\n' | $(UV_COMPILE) pyproject.toml - --extra openvino \
	  -c requirements.lock -o requirements-openvino.lock
	cd $(BACKEND) && $(UV_COMPILE) pyproject.toml --extra rr --extra dev \
	  -c requirements.lock -o requirements-dev.lock

lock-upgrade: ## move requirements.lock to the newest releases (then run the tests)
	$(MAKE) lock LOCK_UPGRADE=--upgrade

# THIRD-PARTY.md: the licences of what a release ships.  The backend half is pip-licenses over a
# throwaway venv built from requirements.lock (the api/worker image's exact set, not the dev
# tools); the frontend half is license-checker over the production dependencies, the only
# packages bundled into the static build (npm ci first when node_modules is absent).
# pip-licenses runs from a venv of its own (--python points it at the lock's venv) so neither
# it nor its dependencies are listed.  Needs python3 and npx.  Regenerate after `make lock` or a
# package.json change and commit the result.
LICENSE_VENV := $(BACKEND)/.venv-licenses
LICENSE_TOOL := $(BACKEND)/.venv-licenses-tool
PIP_LICENSES := $(LICENSE_TOOL)/bin/pip-licenses --python $(LICENSE_VENV)/bin/python
LICENSE_CHECKER := npx --yes license-checker@25.0.1 --production --excludePrivatePackages

third-party: ## regenerate THIRD-PARTY.md from requirements.lock and the frontend's production deps
	rm -rf $(LICENSE_VENV) $(LICENSE_TOOL)
	python3 -m venv $(LICENSE_TOOL)
	$(LICENSE_TOOL)/bin/pip install --quiet pip-licenses==5.5.5
	python3 -m venv $(LICENSE_VENV)
	$(LICENSE_VENV)/bin/pip install --quiet --upgrade pip
	$(LICENSE_VENV)/bin/pip install --quiet --require-hashes -r $(BACKEND)/requirements.lock
	test -d frontend/node_modules || (cd frontend && npm ci --no-audit --no-fund)
	set -e; { \
	  echo '# Third-party software'; \
	  echo; \
	  echo 'Generated by `make third-party`; do not edit by hand.  Keyup itself is licensed under'; \
	  echo 'AGPL-3.0-or-later (LICENSE).  The lists below cover the Python packages the backend image'; \
	  echo 'installs (backend/requirements.lock) and the npm packages bundled into the web build'; \
	  echo '(frontend production dependencies).  Build and test tools are not distributed and are'; \
	  echo 'not listed.'; \
	  echo; \
	  echo 'Compatibility notes:'; \
	  echo; \
	  echo '- mutagen is GPL-2.0-or-later.  The "or later" grant allows it to be used under GPL-3.0,'; \
	  echo '  and GPL-3.0 section 13 permits combining it with AGPL-3.0 code, so the combined work is'; \
	  echo '  distributed under AGPL-3.0-or-later with mutagen itself remaining under its own licence.'; \
	  echo '- psycopg is LGPL-3.0, which permits use from AGPL-3.0 code; it is installed unmodified as'; \
	  echo '  a separate package.'; \
	  echo; \
	  echo '## Backend (Python, backend/requirements.lock)'; \
	  echo; \
	  $(PIP_LICENSES) --from=mixed --with-urls --format=markdown --order=name; \
	  echo; \
	  echo '## Frontend (npm production dependencies)'; \
	  echo; \
	  echo 'Summary:'; \
	  echo; \
	  echo '```'; \
	  (cd frontend && $(LICENSE_CHECKER) --summary); \
	  echo '```'; \
	  echo; \
	  (cd frontend && $(LICENSE_CHECKER) --markdown) | sed -n 's/^\[/- [/p'; \
	} > THIRD-PARTY.md.tmp
	mv THIRD-PARTY.md.tmp THIRD-PARTY.md
	rm -rf $(LICENSE_VENV) $(LICENSE_TOOL)
	@echo "wrote THIRD-PARTY.md"

dev-db: ## start the development Postgres on $(DEV_DB_PORT)
	@docker start $(DEV_DB_NAME) 2>/dev/null || \
	docker run -d --name $(DEV_DB_NAME) \
	  -e POSTGRES_USER=keyup -e POSTGRES_PASSWORD=keyup -e POSTGRES_DB=keyup \
	  -p $(DEV_DB_PORT):5432 -v keyup-dev-pgdata:/var/lib/postgresql $(PG_IMAGE)
	@until docker exec $(DEV_DB_NAME) pg_isready -U keyup >/dev/null 2>&1; do sleep 1; done
	@echo "dev db up: $(DEV_DB_URL)"

test-db: ## start the throwaway test Postgres on $(TEST_DB_PORT)
	@docker start $(TEST_DB_NAME) 2>/dev/null || \
	docker run -d --name $(TEST_DB_NAME) \
	  -e POSTGRES_USER=keyup -e POSTGRES_PASSWORD=keyup -e POSTGRES_DB=keyup_test \
	  -p $(TEST_DB_PORT):5432 $(PG_IMAGE)
	@until docker exec $(TEST_DB_NAME) pg_isready -U keyup >/dev/null 2>&1; do sleep 1; done
	@echo "test db up: $(TEST_DB_URL)"

stop-db: ## stop both development databases
	-docker stop $(DEV_DB_NAME) $(TEST_DB_NAME)

migrate: ## alembic upgrade head against DATABASE_URL
	cd $(BACKEND) && .venv/bin/alembic upgrade head

ingest: ## scan AUDIO_ROOT into the development database
	cd $(BACKEND) && .venv/bin/keyup ingest scan "$(AUDIO_ROOT)" --workers 4

watch: ## run the ingest watcher against AUDIO_ROOT
	cd $(BACKEND) && .venv/bin/keyup ingest watch

test: ## run the test suite (DB tests skip when the test database is unreachable)
	cd $(BACKEND) && TEST_DATABASE_URL="$(TEST_DB_URL)" .venv/bin/pytest -q

migration-roundtrip: ## every alembic revision down and up again, then base -> head (scratch DB beside the test DB)
	cd $(BACKEND) && TEST_DATABASE_URL="$(TEST_DB_URL)" .venv/bin/pytest -q tests/test_migration_roundtrip.py

# The Playwright suite drives a Vite dev server whose /api is proxied to E2E_API, and reads
# whatever archive that API serves: a local `uvicorn app.main:app --port 8096` (the default), or
# a deployment, e.g. `make e2e E2E_API=http://192.0.2.60`.  Signed out it only reads; the
# mutation suite needs E2E_USERNAME/E2E_PASSWORD.  E2E_PORT moves the dev server off 5174 when
# one is already running there; E2E_ARGS is passed to `playwright test` (a spec, --headed, ...).
E2E_API  ?= http://127.0.0.1:8096
E2E_PORT ?= 5174
E2E_ARGS ?=

e2e: ## Playwright e2e against the API at E2E_API (default the local one on 8096), headless
	cd frontend && E2E_PORT=$(E2E_PORT) VITE_API_TARGET=$(E2E_API) npx playwright test $(E2E_ARGS)

lint: ## ruff
	cd $(BACKEND) && .venv/bin/ruff check .

fmt: ## ruff --fix
	cd $(BACKEND) && .venv/bin/ruff check --fix .

# The DNS token below is a placeholder: the Cloudflare plugin only checks its shape (35-50
# url-safe characters), and it is kept under 40 so secret scanners do not read it as a real token.
edge-check: ## validate the HTTPS edge: every Caddyfile (plain, DNS-01, HTTP-01) and compose
	docker build -t keyup-edge-check deploy/edge
	docker run --rm --entrypoint caddy keyup-edge-check \
	  validate --config /etc/caddy/Caddyfile.plain --adapter caddyfile
	docker run --rm \
	  -e KEYUP_TLS_DOMAINS=keyup.example.com \
	  -e CLOUDFLARE_API_TOKEN=edge-check-placeholder-not-a-real-token -e ACME_EMAIL=nobody@example.com \
	  -e ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory \
	  -e EDGE_TRUSTED_PROXIES="192.0.2.1 198.51.100.0/24" \
	  --entrypoint caddy keyup-edge-check \
	  validate --config /etc/caddy/Caddyfile.tls --adapter caddyfile
	docker run --rm \
	  -e KEYUP_TLS_DOMAINS=keyup.example.com \
	  -e CLOUDFLARE_API_TOKEN=edge-check-placeholder-not-a-real-token -e ACME_EMAIL=nobody@example.com \
	  -e ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory \
	  -e EDGE_TRUSTED_PROXIES="192.0.2.1 198.51.100.0/24" \
	  --entrypoint caddy keyup-edge-check \
	  validate --config /etc/caddy/Caddyfile.tls-noredirect --adapter caddyfile
	for f in tls-http01 tls-http01-noredirect; do \
	  docker run --rm \
	    -e KEYUP_TLS_DOMAINS=keyup.example.com -e ACME_EMAIL=nobody@example.com \
	    -e ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory \
	    -e EDGE_TRUSTED_PROXIES="192.0.2.1 198.51.100.0/24" \
	    --entrypoint caddy keyup-edge-check \
	    validate --config /etc/caddy/Caddyfile.$$f --adapter caddyfile || exit 1; \
	done
	docker compose --env-file .env.example config >/dev/null
	KEYUP_TLS_DOMAINS=keyup.example.com docker compose --env-file .env.example config >/dev/null
	@echo "edge ok"

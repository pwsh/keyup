{
  "name": "keyup-frontend",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "author": "Eric Holzhueter",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "gen:api-types": "npm ci --prefix tools/openapi-gen --no-audit --no-fund && tools/openapi-gen/node_modules/.bin/openapi-typescript openapi.json --default-non-nullable false -o src/api/generated.ts && biome format --write src/api/generated.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src e2e",
    "lint:fix": "biome check --write src e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:shots": "playwright test screenshots"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-virtual": "3.14.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}

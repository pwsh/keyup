# Keyup configuration.  Copy to .env and edit; every key mirrors a field on
# backend/app/config.py:Settings (upper-cased).  Values shown are the defaults.

# ---- core -----------------------------------------------------------------------------
# SQLAlchemy URL.  In compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql+psycopg://keyup:keyup@localhost:55440/keyup
# Site profile: a directory of your own agency list (and, for reference, your
# classification rules and shared-channel list).  compose mounts it read-only at /site
# in the `migrate` service; blank mounts examples/.  See examples/*.example.csv.
KEYUP_SITE_DIR=
# The agency CSV the `migrate` step seeds (`keyup seed-agencies --if-configured`), as a
# path inside the container, e.g. /site/agencies.csv.  Blank seeds nothing.
KEYUP_SEED_AGENCIES=
# The agency code `keyup mark-shared` gives the shared dispatch channels nobody owns
# (usually the dispatch center's).  Blank only flags them.  Also an Admin setting.
SHARED_AGENCY_CODE=
# Root of the recording tree.  calls.file_path is relative to it.  On the host this is
# where sdrtrunk writes; compose mounts it at /srv/keyup/audio.
#
# This is still the archive root, but it is no longer the only directory the watcher looks
# at.  The migration seeds it as the first row of `ingest_sources`, and Admin -> Ingest ->
# Sources adds, edits and disables more; the watcher re-reads that table every 30 s, so a
# second recorder's spool starts being ingested without a restart.  A directory outside this
# root is watched just the same and recorded with an absolute file_path.  With no watch_dir
# row at all, this variable is the whole answer, exactly as before (ARCHITECTURE §5.1).
AUDIO_ROOT=/srv/keyup/audio
# Where archived recorder event logs land, one <instance>/<date>.jsonl.gz per day
# (POST /api/recorder/event-log).  A sibling of AUDIO_ROOT rather than a directory inside
# it, deliberately: the ingest walk scans the audio tree and retention purges from it, and
# neither has any business finding a compressed JSONL log there.  compose.yaml binds it.
EVENT_LOG_ROOT=/srv/keyup/eventlogs
# The most one uploaded day of event log may weigh, bytes (100 MB).  A busy site's day
# compresses to single-digit megabytes; past this the upload is refused with 413.
EVENT_LOG_MAX_BYTES=104857600
# The recorder's wall clock: filename stamps and the ID3 Date are naive local time here,
# and the API's naive "local" times are in this zone.  An IANA name, e.g. America/New_York.
TZ=UTC
# File a pushed call under uploads/YYYY/MM/DD/<2 hex from its sha256>/ rather than
# uploads/YYYY/MM/DD/.  The day is always the *call's* own date, never the upload's
# (docs/ARCHITECTURE.md 1.1, "Storage layout").
AUDIO_BUCKET_UPLOADS=true
LOG_LEVEL=INFO
# The address people reach this archive at.  Its scheme decides the Secure cookie flag
# (AUTH_COOKIE_SECURE=auto), and scripts/bootstrap.sh uses it for the recorder [uplink]
# block it prints; bootstrap sets it to http://<this host>:<WEB_PORT> (--public-url).
PUBLIC_URL=http://localhost:8095

# ---- ingest ---------------------------------------------------------------------------
# Full rescan interval for the watcher, behind inotify, so nothing is lost to downtime.
INGEST_SCAN_MINUTES=5
# A file is eligible once its size has been stable this long (sdrtrunk names the file at
# call start and closes it at call end).
INGEST_SETTLE_SECONDS=3
# false = periodic scan only, no inotify (useful on network filesystems).
INGEST_WATCH=true
INGEST_WORKERS=4
# Directories under the scan root the walk never descends into, comma separated.  uploads/
# is written -- and its rows created -- by the push endpoint, so walking it can only ever
# find files the ledger has already settled, at the price of enumerating millions of them.
INGEST_SCAN_SKIP=uploads
# Stop the ingest walk after this many candidate recordings; 0 = no limit.  A guard-rail,
# logged loudly when it fires: a truncated scan is a scan that did not finish.
INGEST_SCAN_MAX_FILES=0
# Fuzzy dedupe: same talkgroups, starts within this many seconds...
DEDUPE_WINDOW_SECONDS=1.0
# ...and durations within this relative tolerance (0.10 = 10 %).
DEDUPE_DURATION_TOLERANCE=0.10
# Consecutive calls on one talkgroup closer than this are one conversation thread.
CONVERSATION_GAP_SECONDS=20

# ---- cross-recorder reconciliation (docs/RECONCILIATION.md) -----------------------------
# Two recorders cover one system, so one transmission arrives twice.  Match the copies on
# interval overlap, keep the better one as the call, fold the other's metadata into it.
# false = the old dedupe: first copy wins and a pushed second copy is not stored at all.
RECONCILE_ENABLED=true
# How far two recorders may disagree about when one transmission happened.  An sdrtrunk
# file's start is derived from the stamp written when the file closes -- measured at
# call end + 1.7 s -- so its row runs ~2 s late and this is what keeps it overlapping the
# trunkd push of the same call.
RECONCILE_CLOCK_SKEW_SECONDS=2.0
# The two intervals must overlap by at least this fraction of the shorter recording...
RECONCILE_MIN_OVERLAP=0.5
# ...unless the shorter one is no longer than this and lies inside the longer: a
# late-granted trunkd fragment of a call the other recorder caught whole.
RECONCILE_FRAGMENT_SECONDS=1.5
# Past this multiple of the other copy's length a recording is two calls joined by
# trunkd's hang timer rather than a better one, and earns no credit for the extra.
RECONCILE_MERGE_RATIO=1.5
# Recorder preference, best first — the lowest-weight tie-break in the score.
RECONCILE_PREFER_SOURCES=["trunkd","trunk_recorder","upload","file"]
# How often the worker runs the batch pass that catches a backlog uploaded after the
# live copy.  `keyup reconcile [--since ISO] [--system NAME] [--dry-run]` is the same pass.
RECONCILE_MINUTES=30

# ---- trunk-recorder (docs/ARCHITECTURE.md 1.7, docs/RECORDERS.md) -----------------------
# Which file becomes the call when trunk-recorder wrote both a WAV and an M4A of it.
# They are the same audio; the M4A is about a tenth the size.  m4a | wav
TR_PREFER_AUDIO=m4a
# trunk-recorder closes the audio and writes the .json sidecar beside it a moment later.
# The watcher holds a settled recording this long waiting for it; if it never arrives the
# call is ingested from the filename and the audio header instead of being dropped.
TR_SIDECAR_WAIT_SECONDS=30

# ---- transcription policy -------------------------------------------------------------
# Default talkgroups.transcribe for a talkgroup ingest creates.
TRANSCRIBE_DEFAULT=true
# Shorter calls are squelch tails (14 % of the corpus); Whisper hallucinates on them.
TRANSCRIBE_MIN_SECONDS=0.75
TRANSCRIBE_MAX_ATTEMPTS=3

# ---- speech to text -------------------------------------------------------------------
# JSON list.  Each entry:
#   {"name": str,
#    "kind": "openai_compatible" | "ovms" | "faster_whisper_local" | "openvino_genai",
#    "base_url": str, "api_key": str, "model": str,
#    "device": str, "compute_type": str, "cpu_threads": int, "cache_dir": str,
#    "concurrency": int, "priority": int, "timeout": float, "enabled": bool}
# `priority` orders backends (lower first) and the scheduler fails over between them.
# Add a faster_whisper_local entry to let the Keyup host transcribe on its own CPU, e.g.
#   {"name":"local","kind":"faster_whisper_local","model":"small","concurrency":1,"priority":90}
# On an Intel Core Ultra host, transcribe on its NPU or Arc iGPU instead.  Three ways in,
# all documented in docs/STT.md §3:
#  1. in-process (single-container deployments, where the process has the Intel drivers):
#     {"name":"npu","kind":"openvino_genai","model":"OpenVINO/whisper-large-v3-turbo-int8-ov","device":"NPU","concurrency":1,"priority":50}
#  2. compose (the api/worker image has no Intel userspace): start the `stt-openvino`
#     profile and point an ordinary openai_compatible entry at it —
#     {"name":"stt-openvino","kind":"openai_compatible","base_url":"http://stt-openvino:8000","model":"OpenVINO/whisper-large-v3-turbo-int8-ov","concurrency":1,"priority":50}
#  3. compose, on Intel's own server: start the `stt-ovms` profile (two containers, NPU and
#     GPU) and use kind=ovms.  `model` is the *served* name — the basename of OVMS_MODEL,
#     not the repo id — and this is the only path that runs whisper on the NPU at all.  It
#     takes no prompt and no hotwords, so quality scoring falls back to text heuristics:
#     {"name":"stt-ovms-npu","kind":"ovms","base_url":"http://stt-ovms-npu:8000","model":"whisper-large-v3-turbo-fp16-ov","concurrency":1,"priority":40}
#     {"name":"stt-ovms-gpu","kind":"ovms","base_url":"http://stt-ovms-gpu:8000","model":"whisper-large-v3-turbo-fp16-ov","concurrency":1,"priority":45}
#
# SEEDING RULE: this variable is a *seed*, not the running configuration.  The migration
# that created the `stt_backends` table copied it in — but only because the table was empty
# — and from then on the database wins: the backends the worker routes to are the rows, and
# this value is read again only if the table has no rows whatsoever.  Add, edit and remove
# backends in Admin -> Backends, where a change reaches the running worker in about ten
# seconds and nothing is restarted.  Editing this line on a deployment that has any row does
# nothing at all (ARCHITECTURE §5.2, app/stt/config_store.py).
# The value below is the CPU whisper server of the `stt-cpu` compose profile (faster-whisper
# small: slow but runs anywhere; COMPOSE_PROFILES and the stt-cpu block below); swap in a GPU
# server's URL and a larger model when you have one (compose.gpu.yaml, docs/STT.md §2).
STT_BACKENDS=[{"name":"whisper","kind":"openai_compatible","base_url":"http://stt-cpu:8000","api_key":"","model":"Systran/faster-whisper-small","concurrency":2,"priority":10}]
# Voice-activity detection on every request; effectively required at these durations.
STT_VAD=true
STT_LANGUAGE=en
# Appended to the domain prompt auto-built from talkgroup aliases, units and place names.
STT_PROMPT_EXTRA=
# Place names heard on this system (towns, campuses, landmarks), comma-separated.  They join
# the domain prompt and the hotword list after the talkgroup and unit aliases.  Like the
# other STT_* knobs above, this is only the default: Admin -> Settings overrides it at runtime.
#   STT_PLACES=Springfield,Shelbyville,State University
STT_PLACES=
STT_WORD_TIMESTAMPS=false
STT_BATCH_SIZE=4
# Hallucination heuristics (ARCHITECTURE 5.2).
STT_NO_SPEECH_THRESHOLD=0.6
STT_COMPRESSION_RATIO_THRESHOLD=2.4
# Site-specific repairs applied to every transcript before it is judged, for words whisper
# writes as domains: `pattern => replacement`, `;`-separated, case-insensitive.  Quote the
# value, e.g. STT_TEXT_REWRITES='\bxcom(\.com)+\b => XCOM'.  Read at start-up.
STT_TEXT_REWRITES=
# Transcription worker threads inside the `worker` process.
STT_WORKERS=2
# A job still 'running' after this long lost its worker and is requeued.
STT_STALE_MINUTES=10
# At most this share of STT_WORKERS may hold a backlog-band job (priority >= 500) at once,
# floored at one thread, so a burst of live calls always finds a free worker.
STT_BACKLOG_WORKER_SHARE=0.5
# Loudness-normalize every clip before transcription (loud alert tones, soft talkers).  This
# is applied to the transcription input only — never to the stored recording, its sha256 or
# the dedupe.  STT_NORMALIZE_FILTER is the ffmpeg -af string; blank uses the built-in default
# for the installed ffmpeg (speechnorm where available, else dynaudnorm, else loudnorm).
# Also togglable at runtime in Admin -> Settings.  (app/stt/normalize.py, ARCHITECTURE §5.2)
STT_NORMALIZE=true
STT_NORMALIZE_FILTER=

# ---- upload admission control (docs/RECORDERS.md, docs/MIGRATION.md) --------------------
# The push path shares one transcription queue between live recorders and a bulk migration
# of the sdrtrunk archive.  These bound it and tell a client to slow down (429/507 with
# Retry-After) instead of letting the queue grow without limit.  All are settable at runtime
# from Admin -> Settings -> Upload as well.
# Open live-band jobs above which even a live push is refused.
UPLOAD_MAX_QUEUE_LIVE=5000
# Open backlog-band jobs above which a priority=backlog|bulk push is refused.
UPLOAD_MAX_QUEUE_BACKLOG=300
# Refuse backlog when the whole queue needs longer than this to drain.
UPLOAD_BACKLOG_MAX_ETA_SECONDS=900
# Simultaneous in-flight backlog uploads one API process will accept.
UPLOAD_BACKLOG_MAX_CONCURRENCY=4
# Free bytes under AUDIO_ROOT below which every class is refused 507 (5 GiB).
UPLOAD_MIN_DISK_FREE_BYTES=5368709120
# Operator switch: stop accepting backlog/bulk entirely.  Live pushes are unaffected.
UPLOAD_PAUSE_BACKLOG=false

# ---- retention ------------------------------------------------------------------------
# Global defaults; a retention_policies row for a system or talkgroup overrides them.
# 0 = keep for ever.
RETENTION_KEEP_DAYS=0
# Purge the MP3 after this many days while keeping the row and transcript (0 = never).
RETENTION_KEEP_AUDIO_DAYS=0
RETENTION_KEEP_TRANSCRIPTS=true
# Move purged audio here instead of deleting it (blank = delete).
RETENTION_ARCHIVE_PATH=
CRON_RETENTION=20 3 * * *
CRON_GAPS=40 3 * * *
# Nightly sweep of finished export bundles older than EXPORT_KEEP_DAYS.
CRON_EXPORT_VACUUM=50 3 * * *

# ---- recorder gap detection -----------------------------------------------------------
# Quiet longer than this on a system that normally has traffic is a recorder gap.
GAP_MINUTES=30

# ---- alerts ---------------------------------------------------------------------------
# Base URL used in alert links (call page and audio URL): the address people reach this
# archive at.  The default is the edge's port on this machine.
PUBLIC_BASE_URL=http://localhost:8095
# Fallback Discord webhook when an alert rule carries none of its own.
DISCORD_WEBHOOK_URL=
# ntfy server (https://ntfy.sh); the topic comes from the rule's channel_config.
NTFY_URL=
# SMTP relay for the `email` channel; a blank host disables it.
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=keyup@localhost
ALERT_TIMEOUT_S=5.0

# ---- auth -----------------------------------------------------------------------------
# Reads are open by default; mutations always need a session or a Bearer token.
AUTH_REQUIRE_READ=false
# Session cookie / token signing key.  CHANGE THIS.
SECRET_KEY=change-me-in-production
AUTH_SESSION_DAYS=14
AUTH_IDLE_HOURS=12
# auto | true | false ("auto" = Secure whenever PUBLIC_URL is https)
AUTH_COOKIE_SECURE=auto
# How many reverse proxies sit in front of this process.  0 (the default) ignores
# X-Forwarded-For entirely and treats the peer as the client; 1 trusts the last hop.
# Anything else lets a caller forge its own address in the audit columns and the login
# rate limiter.  nginx alone in front of the API = 1; the stock compose stack, where the
# `edge` (Caddy) sits in front of nginx, = 2 (edge -> web -> api), which is what compose
# passes the api when this is unset.
TRUSTED_PROXY_HOPS=2
# The Cloudflare Tunnel connector's address(es), space-separated; only they may name the
# visitor with Cf-Connecting-Ip (docs/REVERSE-PROXY.md).  Blank trusts nobody but loopback.
EDGE_TRUSTED_PROXIES=
# Built into the frontend image (docs/ANALYTICS.md).
VITE_GTM_CONTAINER_ID=
VITE_PRIVACY_CONTACT=
# The public site, also built into the frontend image (rebuild `web` after a change).
# VITE_PUBLIC_HOST is the one hostname, without scheme or port (e.g. archive.example.org),
# that gets the front landing page, a canonical link, analytics, robots.txt with a sitemap,
# and pages search engines may index. Blank (the default): no hostname is public - the
# front page is the calls list everywhere, robots.txt disallows everything, and every page
# answers X-Robots-Tag: noindex. The web container's PUBLIC_HOST follows this value.
VITE_PUBLIC_HOST=
# The site's name (page title, landing heading, web manifest), its one-line description
# (meta description, landing page) and the longer line in its structured data. Blank:
# generic wording ("Radio scanner archive", ...). The social image is
# frontend/public/og-image.png; frontend/tools/make-icons.py --text ... draws your own.
VITE_SITE_NAME=
VITE_SITE_DESCRIPTION=
VITE_SITE_ABOUT=

# ---- api ------------------------------------------------------------------------------
# Cap on a single streamed export; 0 = uncapped.
EXPORT_MAX_ROWS=0
# Caps on one POST /api/exports bundle, and how long a finished bundle is kept before the
# nightly vacuum (CRON_EXPORT_VACUUM) deletes it.
EXPORT_MAX_CALLS=20000
EXPORT_MAX_BYTES=2147483648
EXPORT_KEEP_DAYS=7

# ---- stt-cpu profile (docs/STT.md §1) ---------------------------------------------
# Which optional compose services start.  stt-cpu is the CPU whisper server the default
# STT_BACKENDS entry above points at, so a new install has it on; drop it (leave this blank)
# when transcription runs on another machine.  Add stt-openvino, stt-ovms or (with
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml) stt-gpu, comma separated, for the others.
COMPOSE_PROFILES=stt-cpu
# The model the container downloads into its `sttcpu` volume on first start (~500 MB for
# small) and serves; it must equal the `model` of the STT_BACKENDS entry.  int8 is the fast
# CPU format.  STT_CPU_THREADS caps the cores one transcription uses (0 = CTranslate2's
# default); on a small host leave Postgres and ingest a core or two.
STT_CPU_MODEL=Systran/faster-whisper-small
STT_CPU_COMPUTE_TYPE=int8
STT_CPU_THREADS=0
# Loopback port for `curl localhost:8093/health`; the worker uses stt-cpu:8000.
STT_CPU_PORT=8093

# ---- stt-openvino profile (docs/STT.md) -------------------------------------------
# Only read when COMPOSE_PROFILES=stt-openvino.  The accelerator container downloads this
# model into the `ovmodels` volume on first start and caches the compiled blob beside it.
OV_MODEL=OpenVINO/whisper-large-v3-turbo-int8-ov
# CPU | GPU | NPU | AUTO
OV_DEVICE=GPU
OV_CPU_THREADS=4
OV_CONCURRENCY=1
# The gid owning /dev/dri/renderD128 and /dev/accel/accel0 on the machine that runs Docker
# (`ls -l /dev/dri /dev/accel`; docs/STT.md §3.2).
RENDER_GID=992
# Published on the loopback for `curl localhost:8098/health`; the worker uses the network name.
STT_OPENVINO_PORT=8098

# ---- stt-ovms profile (docs/STT.md) -----------------------------------------------
# Only read when COMPOSE_PROFILES includes stt-ovms.  Intel's own model server, one
# container per device; the two do NOT share a volume (each rewrites a graph.pbtxt carrying
# its own target_device into the model directory).  A pre-converted repo from the
# `OpenVINO/` HF org — OVMS's in-server conversion did not work on the Lunar Lake box
# docs/STT.md was measured on.  Pinned by digest: the 2026-08-21 `weekly` build measured
# working there.  Plain `weekly` moves every week and `2026.3` is the July build that failed.
OVMS_IMAGE=openvino/model_server:weekly@sha256:de1d2eed43e2a7c6c8e4802788e13c6c0a47371fe4984f9cce98d0d47c88af41
OVMS_MODEL=OpenVINO/whisper-large-v3-turbo-fp16-ov
# Loopback ports for `curl localhost:<port>/v1/models`; the worker uses the network names.
STT_OVMS_NPU_PORT=8097
STT_OVMS_GPU_PORT=8094

# ---- site channel audit / RadioReference (docs/CHANNEL_AUDIT.md) ------------------------
# The recorder posts what each site announces (POST /api/recorder/observations, `upload`
# scope); RadioReference documents what should be there; Keyup reports the difference.
# All three RR values empty (the default) leaves the RR half dormant — the audit still
# reports observed and configured channels.  A **Premium** subscription and an application
# key of your own are required, and the SOAP client needs the extra:
#   pip install -e 'backend[rr]'
RR_APP_KEY=
RR_USERNAME=
RR_PASSWORD=
# Keyup system name -> RadioReference system id (the number in its database URL), JSON.
# A systems.rr_system_id set through PUT /api/admin/systems/{id}/radioreference wins.
RR_SYSTEMS={}
# Minimum hours between two syncs of one system; RR is somebody else's server.
RR_SYNC_HOURS=24
# A documented channel not heard within this many days counts as "missing".
CHANNEL_AUDIT_STALE_DAYS=14
# How often the worker recomputes the audit, logs a line per site and raises new alerts.
CHANNEL_AUDIT_MINUTES=60

# ---- outbound call exporters (docs/EXPORTERS.md) ----------------------------------------
# Re-publishing this system's live calls to Broadcastify Calls and/or OpenMHz.
#
# BOTH SHIP DISABLED, and the switches are NOT here: they are runtime settings
# (Admin -> Settings -> Export, `export_broadcastify_enabled` / `export_openmhz_enabled`,
# both false).  Only run ONE uploader per system — if sdrtrunk or trunk-recorder is
# already feeding this system, turning these on posts every call twice.
#
# Turning a switch on stamps an enable watermark and only calls recorded *after* that
# instant, and only calls that arrived in the live admission band, are ever uploaded.  An
# archive backfill (priority=backlog/bulk) is never re-published.
#
# Broadcastify **Calls** — the API key from the Broadcastify Calls dashboard, not the
# live-feed mount password.  Blank keeps the exporter dormant however the switch is set.
BROADCASTIFY_API_KEY=
BROADCASTIFY_SYSTEM_ID=
# Conventional systems identify the channel by a predefined frequency-slot id instead of a
# talkgroup; a trunked P25 system leaves this blank.
BROADCASTIFY_SLOT=
# BROADCASTIFY_URL=https://api.broadcastify.com/call-upload
#
# Which credential set is in play.  Broadcastify issues development and production
# credentials separately and each endpoint refuses the other's, so this one value selects
# the URL, the key and the system id together.
# BROADCASTIFY_ENVIRONMENT=production
# The development endpoint, as Broadcastify documents it; development credentials work
# only here and production credentials only against the production endpoint.
# BROADCASTIFY_DEV_URL=https://api.broadcastify.com/call-upload-dev
BROADCASTIFY_DEV_API_KEY=
BROADCASTIFY_DEV_SYSTEM_ID=
#
# The upload format: m4a (AAC 32 kbit/s, 18 kHz cutoff — what Broadcastify prefers) or mp3
# (CBR mono 22050 Hz at 32 or 16 kbit/s).  Drives the encode, the `enc` field and the PUT's
# Content-Type together.
# BROADCASTIFY_ENCODING=m4a
# BROADCASTIFY_MP3_BITRATE_KBPS=32
#
# Step 1 of Broadcastify's upload workflow is "verify time synchronization on the host
# system": `ts` is part of the tuple they deduplicate on.  Keyup measures the offset against
# this server (one SNTP datagram) and PAUSES the Calls uploads — not the feed, not OpenMHz —
# while it is more than 5 s out.  Blank turns the query off; an offset that could not be
# measured never pauses anything.
# EXPORT_NTP_SERVER=pool.ntp.org

# OpenMHz — the per-system API key and the system's shortName (its URL path segment).
OPENMHZ_API_KEY=
OPENMHZ_SHORT_NAME=
# OPENMHZ_URL=https://api.openmhz.com

# Retries, pacing and the safety bound on how stale a call may be when it is picked up.
EXPORT_MAX_ATTEMPTS=5
EXPORT_POLL_SECONDS=15
EXPORT_MIN_INTERVAL_S=1.0
EXPORT_TIMEOUT_S=30
EXPORT_BATCH_SIZE=20
EXPORT_MAX_AGE_MINUTES=60

# ---- outbound webhooks (docs/WEBHOOKS.md) -----------------------------------------------
# One HTTP endpoint told about the events a consumer can act on, so a CAD integration can
# match a new call the moment it lands instead of polling /calls on a timer.
#
# **A blank URL is the off switch, and that is how this ships.**  Nothing is queued, the
# webhook_deliveries table stays empty, and the worker's tick returns at once.  An empty
# WEBHOOK_EVENTS means the same even with a URL set: half a filled-in form is not consent.
#
# All four are also runtime settings (Admin → Settings → Webhooks), which is how a consumer's receiver
# gets switched off during their maintenance window without a keyup deploy.  The signing
# secret is write-only there: it can be set and cleared, never read back.
WEBHOOK_URL=
# HMAC-SHA256 over the exact request body, sent as `X-Keyup-Signature: sha256=<hex>`.
# Blank sends no signature at all — only sensible on a trusted LAN, since the receiver then
# has no way to tell a real call from anybody who found the URL.
WEBHOOK_SECRET=
# Comma-separated subset of: call.stored, call.transcribed, link.created, link.deleted
WEBHOOK_EVENTS=
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_POLL_SECONDS=5
WEBHOOK_BATCH_SIZE=20
WEBHOOK_TIMEOUT_S=10

# ---- compose only ---------------------------------------------------------------------
POSTGRES_USER=keyup
POSTGRES_PASSWORD=keyup
POSTGRES_DB=keyup
# Postgres memory sizing (compose.yaml `db`).  The defaults suit a ~4 GB host that also runs
# the rest of the stack and stt-cpu.  Roughly 25% / 60% of the RAM Postgres can count on
# for shared_buffers / effective_cache_size; work_mem is per sort or hash and multiplies by
# every concurrent query.  Changing any of them recreates the db container (a few seconds).
#
#   host RAM   SHARED_BUFFERS  EFFECTIVE_CACHE_SIZE  WORK_MEM  MAINTENANCE_WORK_MEM  MAX_WAL_SIZE  SHM_SIZE
#   4 GB       512MB           2GB                   16MB      128MB                 1GB           256m
#   8 GB       1GB             4GB                   32MB      256MB                 1GB           512m
#   16 GB      3GB             9GB                   32MB      512MB                 2GB           1g
#   32 GB      8GB             20GB                  64MB      1GB                   4GB           2g
#
# PG_SHM_SIZE is the container's /dev/shm, where parallel query workers exchange results
# (and parallel hash joins keep their tables).  Docker's 64 MB default is too small: one
# stats query wanted 16 MB x 3 workers and failed with "could not resize shared memory
# segment".  It is tmpfs, so it costs nothing until used, but it can run out under load:
# ~30 simultaneous full-text searches exhausted 1 GB, which is why searches now queue for
# a few slots and use one parallel worker each (app/api/search_load.py).  Give it more if
# the Postgres log shows that error again.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=2GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_WAL_SIZE=1GB
PG_SHM_SIZE=256m
# Published on 127.0.0.1 only; the API and worker reach the database over the compose
# network, so this port is for psql on the host and nothing else.
DB_PORT=55440
API_PORT=8096
# The edge's plain-HTTP port.  HTTP-01 certificates need WEB_PORT=80 and WEB_TLS_PORT=443
# (HTTPS section below).
WEB_PORT=8095

# ---- HTTPS at the edge (docs/HTTPS.md) ---------------------------------------------
# The `edge` service is Caddy in front of nginx.  It publishes WEB_PORT as plain HTTP and
# WEB_TLS_PORT as HTTPS, and gets its certificates from Let's Encrypt by one of two ACME
# challenges (KEYUP_TLS_CHALLENGE below):
#   http — HTTP-01 / TLS-ALPN-01: the names resolve publicly to this box and inbound 80 and
#          443 reach it, so set WEB_PORT=80 and WEB_TLS_PORT=443.  No credential needed.
#          Beta: not yet run against Let's Encrypt itself; rehearse on staging (ACME_CA).
#   dns  — DNS-01 through Cloudflare: a name that only resolves on the LAN can carry a
#          publicly trusted certificate with no inbound port at all.  Needs the token.
#
# BLANK KEYUP_TLS_DOMAINS IS THE OFF SWITCH, and that is how this ships: the edge then
# serves plain HTTP on WEB_PORT and the stack behaves exactly as it did before it existed.
# Space-separated hostnames, e.g. `keyup.example.com keyup.lan.example.com`.
KEYUP_TLS_DOMAINS=
WEB_TLS_PORT=8443
# auto (default) = dns when CLOUDFLARE_API_TOKEN is set, http otherwise; or dns / http.
KEYUP_TLS_CHALLENGE=auto
# A Cloudflare API token — NOT the global API key — scoped Zone -> DNS -> Edit on the one
# zone that holds these names.  That is the entire permission DNS-01 needs.  Not used
# by HTTP-01.
CLOUDFLARE_API_TOKEN=
# Contact address on the ACME account (expiry warnings go here).  Required with TLS on.
ACME_EMAIL=
# Blank = Let's Encrypt production.  Point it at
# https://acme-staging-v02.api.letsencrypt.org/directory to rehearse without spending
# rate limit; staging certificates are not trusted, so expect `curl -k`.
ACME_CA=
# With TLS on: what plain :80 does.  true (the default) 308s browsers to https; false
# serves the whole site in the clear *as well as* https, for a client on the LAN that
# cannot follow a redirect.  Either way /health and /api/* answer over plain http and are
# never redirected — recorders push by IP, and no certificate can cover an IP address.
KEYUP_TLS_REDIRECT_HTTP=true
#
# ALL SEVEN ARE THE BOOTSTRAP, NOT THE LAST WORD.  They decide what the edge container starts
# on; the same seven are runtime settings (Admin -> HTTPS), and a row set there wins from the
# moment the API pushes it into the running proxy over Caddy's admin API.  An unset row
# falls through to the value here.  docs/HTTPS.md, "Where the configuration comes from".
#
# With TLS on, set PUBLIC_URL and PUBLIC_BASE_URL to https://<the first domain> by hand.
# Nothing derives them: they are what alert links and the Secure cookie decision read.

# ---- api ---------------------------------------------------------------------------
# Where POST /api/exports writes its zip bundles (audio + calls.csv + transcripts.json).
EXPORT_DIR=/srv/keyup/exports
# Where deploy/backup/keyup-db-backup.sh writes the database dumps (docs/OPERATIONS.md §7).
# The worker mounts it read-only for the "backup overdue" health check; unset, compose
# uses ./backups/db beside compose.yaml.
# BACKUP_DIR=/srv/keyup/backups/db
# Cached waveform peak files; unset = <AUDIO_ROOT>/../cache/waveform
# WAVEFORM_CACHE_DIR=/srv/keyup/cache/waveform
# Peak buckets returned by GET /api/calls/{id}/waveform
WAVEFORM_BUCKETS=200
# How often the live feed emits an ingest.status heartbeat, seconds
LIVE_STATUS_SECONDS=15
